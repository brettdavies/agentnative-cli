
use builtin;
use str;

set edit:completion:arg-completer[anc] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'anc'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'anc'= {
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand audit 'Audit a CLI project or binary for agent-readiness'
            cand completions 'Generate shell completions'
            cand emit 'Render build artifacts (coverage matrix, scorecard schema)'
            cand skill 'Install or manage the agentnative skill bundle'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'anc;audit'= {
            cand --command 'Resolve a command from PATH and run behavioral checks against it'
            cand --principle 'Filter checks by principle number (1-8)'
            cand --output 'Output format'
            cand --audit-profile 'Exemption category for the target. Suppresses checks that do not apply to this class of tool — e.g., TUI apps legitimately intercept the TTY, so `--audit-profile human-tui` skips the interactive-prompt MUSTs. Suppressed checks emit `Skip` with structured evidence so readers see what was excluded'
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand --binary 'Run only behavioral checks (skip source analysis)'
            cand --source 'Run only source checks (skip behavioral)'
            cand --include-tests 'Include test code in source analysis'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'anc;completions'= {
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'anc;emit'= {
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help'
            cand --help 'Print help'
            cand coverage-matrix 'Render the spec coverage matrix (registry → checks → artifact)'
            cand schema 'Print the scorecard JSON Schema (draft 2020-12) to stdout'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'anc;emit;coverage-matrix'= {
            cand --out 'Path for the Markdown artifact. Defaults to `docs/coverage-matrix.md`'
            cand --json-out 'Path for the JSON artifact. Defaults to `coverage/matrix.json`'
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand --check 'Exit non-zero when committed artifacts differ from rendered output. CI drift guard'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'anc;emit;schema'= {
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'anc;emit;help'= {
            cand coverage-matrix 'Render the spec coverage matrix (registry → checks → artifact)'
            cand schema 'Print the scorecard JSON Schema (draft 2020-12) to stdout'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'anc;emit;help;coverage-matrix'= {
        }
        &'anc;emit;help;schema'= {
        }
        &'anc;emit;help;help'= {
        }
        &'anc;skill'= {
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand install 'Install the skill bundle into a host''s canonical skills directory'
            cand update 'Refresh an installed skill bundle to the latest upstream revision'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'anc;skill;install'= {
            cand --output 'Output format for the result envelope'
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand --all 'Install into every known host in one invocation'
            cand --dry-run 'Print the resolved git command without spawning. Captures cleanly via `eval $(anc skill install --dry-run <host>)`'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'anc;skill;update'= {
            cand --output 'Output format for the result envelope'
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (https://no-color.org/)'
            cand --all 'Refresh every known host in one invocation'
            cand --dry-run 'Print the resolved commands without spawning'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr)'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per check. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'anc;skill;help'= {
            cand install 'Install the skill bundle into a host''s canonical skills directory'
            cand update 'Refresh an installed skill bundle to the latest upstream revision'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'anc;skill;help;install'= {
        }
        &'anc;skill;help;update'= {
        }
        &'anc;skill;help;help'= {
        }
        &'anc;help'= {
            cand audit 'Audit a CLI project or binary for agent-readiness'
            cand completions 'Generate shell completions'
            cand emit 'Render build artifacts (coverage matrix, scorecard schema)'
            cand skill 'Install or manage the agentnative skill bundle'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'anc;help;audit'= {
        }
        &'anc;help;completions'= {
        }
        &'anc;help;emit'= {
            cand coverage-matrix 'Render the spec coverage matrix (registry → checks → artifact)'
            cand schema 'Print the scorecard JSON Schema (draft 2020-12) to stdout'
        }
        &'anc;help;emit;coverage-matrix'= {
        }
        &'anc;help;emit;schema'= {
        }
        &'anc;help;skill'= {
            cand install 'Install the skill bundle into a host''s canonical skills directory'
            cand update 'Refresh an installed skill bundle to the latest upstream revision'
        }
        &'anc;help;skill;install'= {
        }
        &'anc;help;skill;update'= {
        }
        &'anc;help;help'= {
        }
    ]
    $completions[$command]
}
