
use builtin;
use str;

set edit:completion:arg-completer[anc] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'anc'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'anc'= {
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (<https://no-color.org/>)'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr). `AGENTNATIVE_QUIET` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr). `AGENTNATIVE_QUIET` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear. `AGENTNATIVE_VERBOSE` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear. `AGENTNATIVE_VERBOSE` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per audit. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand audit 'Audit a CLI project or binary for agent-readiness'
            cand web 'Audit a website for agent-readiness'
            cand completions 'Generate shell completions'
            cand emit 'Render build artifacts (coverage matrix, scorecard schema)'
            cand skill 'Install or manage the agentnative skill bundle'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'anc;audit'= {
            cand --command 'Resolve a command from PATH and run behavioral audits against it'
            cand --bin 'Grade this binary when the directory builds several: a bin name, or the path anc prints for it. Unrelated to --binary, which runs only behavioral audits'
            cand --repo 'Read `.anc.toml` from this directory instead of the target''s repository. For a repo you fetched for a tool installed elsewhere: anc reads `<PATH>/.anc.toml` over `~/.anc.toml` and never fetches'
            cand --principle 'Filter audits by principle number (1-8)'
            cand --output 'Output format'
            cand --jobs 'Threads that read source files for source analysis, at least 1. Default: one per available core, capped to bound memory, and never more than the files read'
            cand --audit-profile 'Exemption category for the target. Suppresses audits that do not apply to this class of tool — e.g., TUI apps legitimately intercept the TTY, so `--audit-profile human-tui` skips the interactive-prompt MUSTs. Suppressed audits emit `Skip` with structured evidence so readers see what was excluded'
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (<https://no-color.org/>)'
            cand --binary 'Run only behavioral audits (skip source analysis). To choose which binary a directory grades, use --bin'
            cand --source 'Run only source audits (skip behavioral)'
            cand --include-tests 'Include test code in source analysis'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr). `AGENTNATIVE_QUIET` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr). `AGENTNATIVE_QUIET` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear. `AGENTNATIVE_VERBOSE` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear. `AGENTNATIVE_VERBOSE` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per audit. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'anc;web'= {
            cand --site-type 'Score only the checks that apply to this kind of site. Omitted, every check applies, matching the hosted auditor''s default'
            cand --check 'Report one check by id and exit with that row''s code. Run `anc emit web-checks` for the full list of ids'
            cand --ca-cert 'Also trust the root certificates in this PEM file, for any target. Repeat for several files. A local or private target already trusts the OS trust store; a public target trusts the bundled Mozilla roots. Chain and hostname checks always run'
            cand --token-host 'The URL host a token on stdin belongs to: a hostname with an optional port, such as `mcp.example.com` or `localhost:8787`, with no scheme, path, query, or userinfo. No port means 443. The token goes only to an MCP endpoint of record on exactly this host, and a declared host has to confirm the endpoint first. It does not bind `ANC_WEB_TOKEN`, which `ANC_WEB_TOKEN_HOST` binds; given beside that variable, it must name the same host'
            cand --output 'Output format'
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (<https://no-color.org/>)'
            cand --external-dns 'Let the DNS-over-HTTPS checks query public resolvers even when the target is local or private. Without it those rows report `n_a` rather than sending the target''s hostname to a third party. It and `--no-external-dns` override each other, and the last one wins'
            cand --no-external-dns 'Withhold the DNS-over-HTTPS checks for any target, so the target''s hostname never reaches a public resolver. Those rows report `n_a`. Use it for an internal host on a routable address, which reads as public. It and `--external-dns` override each other, and the last one wins'
            cand --no-follow 'Audit only the target: leave unrequested every host its discovery documents declare. Rows that depend on a declared host report `n_a` (`follow-disabled`), and the scorecard records `follow_declarations: false`'
            cand --token-stdin 'Read a bearer token for the audited MCP endpoint from the first line of stdin, in place of `ANC_WEB_TOKEN`. The token goes only to that endpoint''s handshake and session requests, and only when `--token-host` names its host'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr). `AGENTNATIVE_QUIET` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr). `AGENTNATIVE_QUIET` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear. `AGENTNATIVE_VERBOSE` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear. `AGENTNATIVE_VERBOSE` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
            cand --json 'Emit JSON output. Short alias for `--output json` on subcommands that support it. Per the agent-native convention (`p2-should-json-aliases`), the short form works alongside the canonical `--output` enum'
            cand --raw 'Strip section headers, evidence lines, summary line, and badge hint — emit only `id<TAB>status` per audit. Pipe-safe for grep, awk, and downstream tooling that wants the raw verdict stream without prose. Ignored in `--output json` mode'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'anc;completions'= {
            cand --color 'Color control for text output. `auto` (default) emits ANSI styling when stdout is a terminal and `NO_COLOR` is unset. `always` forces styling on; `never` strips it. Honors the `NO_COLOR` environment variable in `auto` mode (<https://no-color.org/>)'
            cand -q 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr). `AGENTNATIVE_QUIET` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --quiet 'Suppress non-essential output. Default: false (warnings and progress notes are written to stderr). `AGENTNATIVE_QUIET` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand -v 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear. `AGENTNATIVE_VERBOSE` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --verbose 'Escalate diagnostic detail. `-v` is shorthand for `--verbose`. Mutually exclusive with `--quiet`; the last flag on the command line wins when both appear. `AGENTNATIVE_VERBOSE` turns it on for any value but `0`, `false`, `no`, `off`, or empty'
            cand --examples 'Print a curated examples block and exit. Pairs with `--output json` (or `--json`) so structured-output consumers can fetch the examples without parsing the full `--help` body'
