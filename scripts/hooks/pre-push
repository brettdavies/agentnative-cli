#!/usr/bin/env bash
# Local CI mirror — runs the same checks as the GitHub Actions CI pipeline.
# Use as a pre-push hook or run manually before pushing.
#
# Exit codes: 0 = all pass, 1 = failure
#
# Requires bash >= 4.4 (mapfile, and empty-array expansion under `set -u`). The
# guard re-execs under Homebrew's bash when `#!/usr/bin/env bash` found an older
# one, such as the macOS /bin/bash 3.2, and otherwise stops with the install hint.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "ERROR: needs bash >= 4.4 (running $BASH_VERSION); install it with: brew install bash" >&2
  exit 1
fi

# A linked worktree can find core.hooksPath set to the main checkout's
# absolute path (worktree tooling writes it), and git then runs the main
# checkout's copy of this hook with the worktree as its working directory.
# Hand off to the copy that worktree has checked out, so a push or commit is
# gated by the hook its own branch carries.
hook_self_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
hook_worktree_root=$(pwd -P)
hook_own_copy="$hook_worktree_root/scripts/hooks/$(basename "${BASH_SOURCE[0]}")"
if [[ "$hook_worktree_root" != "$hook_self_root" && -x "$hook_own_copy" ]]; then
  exec "$hook_own_copy" "$@"
fi

# From a linked worktree git exports GIT_DIR, which sends a tool's git calls in
# any directory to this repository: cargo-deny 0.19.1 through 0.19.5 reset the
# pushed branch during the advisory fetch (fixed in 0.19.6,
# https://github.com/EmbarkStudios/cargo-deny/pull/858). Pre-push has no
# temporary index, and discovery from the hook's cwd (the worktree root) finds
# the same repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

pass() { echo -e "  ${GREEN}✓${RESET} $1"; }
fail() { echo -e "  ${RED}✗${RESET} $1"; exit 1; }

echo -e "${BOLD}Running local CI checks...${RESET}"

# The toolchain is pinned in rust-toolchain.toml — both local and CI read the same file
# and install the same version. Rustup verifies component SHA256s from the distribution
# manifest, so the pin is effectively a SHA pin. No `rustup update` step here: bumping
# the toolchain is a reviewed PR that updates rust-toolchain.toml.
pass "toolchain ($(rustc --version 2>/dev/null | awk '{print $2}' || echo unknown))"

# 1. Format check
cargo fmt -- --check 2>/dev/null || fail "cargo fmt -- --check"
pass "fmt"

# 2. Clippy with warnings-as-errors: CI's RUSTFLAGS=-Dwarnings as a clippy
# argument, since cargo keys every dependency build on RUSTFLAGS.
cargo clippy --quiet -- -D warnings 2>&1 || fail "cargo clippy -- -D warnings"
pass "clippy"

# 2b. The `web` feature (the local web audit, off by default), as CI's
# "Web feature" job builds it.
cargo clippy --quiet --all-targets --features web -- -D warnings 2>&1 \
    || fail "cargo clippy --all-targets --features web -- -D warnings"
pass "clippy (web feature)"

# 3. Tests, for the default feature set and for the `web` feature.
cargo test --quiet 2>&1 || fail "cargo test"
pass "test"
cargo test --quiet --features web 2>&1 || fail "cargo test --features web"
pass "test (web feature)"

# 3b. Doc build — the crate publishes a library whose docs.rs page is the
# README plus the `web_audit` surface, so a broken intra-doc link, an
# unclosed code fence or a bare URL is a rendering bug on a published page.
# RUSTDOCFLAGS=-D warnings makes every doc warning a failure, and
# `#![deny(missing_docs)]` in src/lib.rs makes an undocumented public item
# one too.
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --quiet 2>&1 || fail "cargo doc --no-deps (RUSTDOCFLAGS=-D warnings)"
pass "doc"
# docs.rs builds with every feature on ([package.metadata.docs.rs]), so the
# `web` build's pages are the published ones.
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --quiet --features web 2>&1 \
    || fail "cargo doc --no-deps --features web (RUSTDOCFLAGS=-D warnings)"
pass "doc (web feature)"

# 4. Security audit (licenses + advisories) — skip if cargo-deny not installed
if cargo deny --version &>/dev/null; then
    cargo deny check 2>&1 || fail "cargo deny check"
    pass "deny"
else
    echo "  - deny (skipped, cargo-deny not installed)"
fi

# 5. Shellcheck — lint shell scripts (and the pre-push hook itself). Severity
# threshold "warning" catches real bugs (unused vars, quoting issues, missing
# exits) while ignoring info/style noise like SC2016 for intentional jaq
# filters with single quotes. Skip silently if shellcheck isn't installed —
# the maintainer machine has it via Homebrew (`brew install shellcheck`).
if command -v shellcheck &>/dev/null; then
    mapfile -t shell_files < <({
        git ls-files '*.sh' 2>/dev/null
        git ls-files 'scripts/hooks/*' 2>/dev/null
    } | sort -u)
    if [ ${#shell_files[@]} -gt 0 ]; then
        shellcheck --severity=warning "${shell_files[@]}" || fail "shellcheck --severity=warning"
    fi
    pass "shellcheck"
else
    echo "  - shellcheck (skipped: install via \`brew install shellcheck\` or \`apt install shellcheck\`)"
fi

# 6. Windows cross-check (fast): verify no unconditional use of unix-only APIs.
# Catches the libc::SIGPIPE class of issue without invoking a Windows toolchain
# — runs in milliseconds. Step 7 is the comprehensive backstop.
if rg -n 'libc::(SIGPIPE|SIG_DFL|signal)' --type rust src/ | rg -v '#\[cfg(unix)\]' | rg -v '// *#\[cfg' | rg -qv '^$'; then
    violations=$(rg -n 'libc::(SIGPIPE|SIG_DFL|signal)' --type rust src/ 2>/dev/null || true)
    if [ -n "$violations" ]; then
        while IFS= read -r line; do
            file=$(echo "$line" | cut -d: -f1)
            lineno=$(echo "$line" | cut -d: -f2)
            before=$(sed -n "$((lineno > 3 ? lineno - 3 : 1)),${lineno}p" "$file")
            if ! echo "$before" | rg -q 'cfg\(unix\)'; then
                fail "libc unix-only API used without #[cfg(unix)] at $file:$lineno"
            fi
        done <<< "$violations"
    fi
    pass "windows compat (libc grep)"
else
    pass "windows compat (libc grep)"
fi

# 7. Windows cross-clippy: full type-check of the codebase as if compiling for
# x86_64-pc-windows-gnu. Catches cfg-gated unused imports, conditional dead
# code, and any other warning class that only surfaces on Windows. Linux
# clippy alone misses these because `#[cfg(unix)]` filters out their usage
# sites locally — the warning only fires on the platform where the gate
# excludes them.
#
# Requirements (one-time setup):
#   sudo apt install mingw-w64                          # the C linker tree-sitter needs
#   rustup target add x86_64-pc-windows-gnu             # the Windows std library
#   brew install nasm                                   # the `web` feature only: aws-lc-sys assembles with it on x86-64 Windows
#
# The `web` feature also needs cmake, which the native build already uses.
# If a tool is missing its step is skipped with a one-line note rather than
# failing — but local Windows coverage is then absent, and CI's Windows jobs
# become the only backstop. Install all of them to close that gap.
if command -v x86_64-w64-mingw32-gcc &>/dev/null \
    && rustup target list --installed 2>/dev/null | grep -q '^x86_64-pc-windows-gnu$'; then
    cargo clippy --target x86_64-pc-windows-gnu --all-targets --quiet -- -D warnings 2>&1 \
        || fail "cargo clippy --target x86_64-pc-windows-gnu -- -D warnings"
    pass "windows clippy (cross-target)"
    if command -v nasm &>/dev/null; then
        cargo clippy --target x86_64-pc-windows-gnu --all-targets --features web --quiet -- -D warnings 2>&1 \
            || fail "cargo clippy --target x86_64-pc-windows-gnu --all-targets --features web -- -D warnings"
        pass "windows clippy (cross-target, web feature)"
    else
        echo "  - windows clippy, web feature (skipped: install \`nasm\` to enable)"
    fi
else
    echo "  - windows clippy (skipped: install \`mingw-w64\` + \`rustup target add x86_64-pc-windows-gnu\` to enable)"
fi

echo -e "${BOLD}${GREEN}All checks passed.${RESET}"
