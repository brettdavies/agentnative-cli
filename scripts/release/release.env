# Per-repo release values, sourced by scripts/release/_lib.sh. preflight,
# postflight and sync-dev are separate entry points, so a value declared in one
# script is missing from the other two; this file is the one place all three
# read.

# Drift gate 0 reads the manifest of the last tag reachable from main, as this
# describe does. v0.7.0's Cargo.toml has no `web` feature, and dev's has one, so
# the gate compares the manifest by its version alone until a newer tag is on
# main, whose manifest matches dev's line for line. CHANGELOG.md stays on the
# line check. A clone with no tags cannot tell, so it takes the same setting.
case "$(git describe --tags --abbrev=0 --match 'v[0-9]*' origin/main 2>/dev/null)" in
  "" | v0.7.0) DRIFT_MANIFEST_COMPARE="version" ;;
esac
