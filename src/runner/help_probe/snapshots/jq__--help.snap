  23 | -n, --null-input | use `null` as the single input value;
  24 | -R, --raw-input | read each line as string instead of JSON;
  25 | -s, --slurp | read all inputs into an array and use it as the single input
  27 | -c, --compact-output | compact instead of pretty-printed output;
  28 | -r, --raw-output | output strings without escapes and quotes;
  29 | --raw-output0 | implies -r and output NUL after each output;
  30 | -j, --join-output | implies -r and output without newline after each output;
  32 | -a, --ascii-output | output strings by only ASCII characters using escape sequenc
  34 | -S, --sort-keys | sort keys of each object on output;
  35 | -C, --color-output | colorize JSON output;
  36 | -M, --monochrome-output | disable colored output;
  37 | --tab | use tabs for indentation;
  38 | --indent | use n spaces for indentation (max 7 spaces);
  39 | --unbuffered | flush output stream after each output;
  40 | --stream | parse the input value in streaming fashion;
  41 | --stream-errors | implies --stream and report parse error as an array;
  43 | --seq | parse input/output as application/json-seq;
  44 | -f, --from-file | load the filter from a file;
  45 | -L, --library-path | search modules from the directory;
  46 | --arg | set $name to the string value;
  47 | --argjson | set $name to the JSON value;
  48 | --slurpfile | name file set $name to an array of JSON values read from the
  50 | --rawfile | set $name to string contents of file;
  51 | --args | consume remaining arguments as positional string values;
  53 | --jsonargs | consume remaining arguments as positional JSON values;
  55 | -e, --exit-status | set exit status code based on the output;
  56 | -V, --version | show the version;
  57 | --build-configuration | show jq's build configuration;
  58 | -h, --help | show the help;
