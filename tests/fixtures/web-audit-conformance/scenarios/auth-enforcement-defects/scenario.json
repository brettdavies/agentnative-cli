{
  "description": "an endpoint that requires sign-in lists an http authorization server and serves a legacy tools/list without a token: the challenge row passes, the metadata row is broken, and the refusal row is noncompliant",
  "covers": [
    "mcp-auth-challenge",
    "mcp-auth-servers",
    "mcp-auth-enforced"
  ],
  "target": "https://example.com/",
  "site_type": null,
  "spec_version": "0.0.0-corpus",
  "unmatched": {
