{
  "description": "a root that challenges for auth still audits, and the challenge satisfies the auth antecedent",
  "covers": [
    "auth-md",
    "oauth-discovery",
    "agent-ua-reachable"
  ],
  "target": "https://example.com/",
  "site_type": null,
  "spec_version": "0.0.0-corpus",
  "unmatched": {
    "status": 404,
    "headers": {
      "content-type": "text/html; charset=utf-8"
    },
    "body": "<html><body><h1>Not found</h1><p>No such page.</p></body></html>"
  },
  "allow_unmatched": true,
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://example.com/"
      },
      "response": {
        "status": 401,
        "headers": {
          "content-type": "text/html; charset=utf-8",
          "www-authenticate": "Bearer realm=\"example\""
        },
        "body": "<html><body>Sign in</body></html>"
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://example.com/.well-known/auth.md"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/markdown; charset=utf-8"
        },
        "body": "# Auth\n\nRegister first.\n"
      }
    }
  ]
}
